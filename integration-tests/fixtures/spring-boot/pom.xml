<?xml version="1.0" encoding="UTF-8"?>
<!-- @author kongweiguang -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>
    <groupId>io.github.kongweiguang.xjar.plus.integration</groupId>
    <artifactId>spring-boot-fixture</artifactId>
    <version>1.0.0</version>
    <properties>
        <boot.version>2.7.18</boot.version>
        <java.version>${fixture.java.version}</java.version>
        <fixture.java.version>8</fixture.java.version>
        <web.starter>spring-boot-starter-web</web.starter>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>${web.starter}</artifactId>
        </dependency>
    </dependencies>
    <build>
        <finalName>app-${boot.version}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
