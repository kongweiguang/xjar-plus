<?xml version="1.0" encoding="UTF-8"?>
<!-- @author kongweiguang -->
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.kongweiguang.xjar.plus</groupId>
        <artifactId>xjar-plus-parent</artifactId>
        <version>2.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>xjar-plus-core</artifactId>
    <name>XJar Plus Core</name>
    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>xjar-plus-format</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>xjar-plus-runtime</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>xjar-plus-runtime-boot-modern</artifactId>
        </dependency>
        <dependency>
            <groupId>tools.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>${project.basedir}/../launcher</directory>
                <targetPath>xjar-plus-launcher-template</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>go.mod</include>
                    <include>go.sum</include>
                    <include>cmd/**/*.go</include>
                    <include>cmd/launcher/payload/README.md</include>
                    <include>internal/**/*.go</include>
                </includes>
                <excludes>
                    <exclude>**/*_test.go</exclude>
                </excludes>
            </resource>
        </resources>
    </build>
</project>
